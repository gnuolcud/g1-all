#!url=https://raw.githubusercontent.com/gnuolcud/g1-all/main/g1-all.sgmodule
#!name=G1 ACQ v2 (discount + free)
#!desc=2TB 12thang -90% | Ultra 3thang -75% | 20TB 3thang -75% | Helium free 1thang
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-probe3 = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/a0a8f67/g1-all.js

[MITM]
hostname = %APPEND% one.google.com
