#!url=https://raw.githubusercontent.com/gnuolcud/g1-all/main/g1-all.sgmodule
#!name=G1 PROBE v3 (ma that)
#!desc=Test ma that tu catalog frida.js tren iOS (FREE 6 thang + nhieu discount moi)
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-probe3 = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/17342ff/g1-all.js

[MITM]
hostname = %APPEND% one.google.com
