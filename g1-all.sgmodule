#!url=https://raw.githubusercontent.com/gnuolcud/g1-all/main/g1-all.sgmodule
#!name=G1 ACQ Plus v8.0 (Pro 18M FREE + Ultra 1M FREE)
#!desc=Pro 5TB 18thang FREE | Ultra 20TB/30TB 1thang FREE | 45 free SKUs | 1-click switch | auto fallback
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/889ccc6/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/889ccc6/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
