#!url=https://raw.githubusercontent.com/gnuolcud/g1-all/main/g1-all.sgmodule
#!name=G1 ACQ v8.1-ios (Pro 7k + Ultra Thổ)
#!desc=Pro 5TB Gemini ~7k VND/T | Ultra 20TB/30TB SKU Thổ | 586 dòng gọn nhẹ
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/751fb36/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/751fb36/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
