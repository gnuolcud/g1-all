#!url=https://cdn.jsdelivr.net/gh/gnuolcud/g1-all@main/g1-all.sgmodule
#!name=G1 All-in-One
#!desc=Ultra 30TB free 1 tháng + 20TB -90% 3 tháng + Pro -90% 12 tháng
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-ultra-1m-free = type=http-response,pattern=^https:\/\/one\.google\.com\/(ai|upsell|plans|storage),requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/gnuolcud/g1-all@main/g1-all.js

[MITM]
hostname = %APPEND% one.google.com
