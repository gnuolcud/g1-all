#!url=https://raw.githubusercontent.com/gnuolcud/g1-all/main/g1-all.sgmodule
#!name=G1 ACQ Plus v8.1 (Pro 12T $1.99 + Ultra 1M FREE)
#!desc=Pro 5TB 12 tháng giảm 90% ($1.99/tháng) | Ultra 20TB/30TB 1 tháng FREE | 1-click switch | auto fallback
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/9c5cad7/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/9c5cad7/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
