#!url=https://raw.githubusercontent.com/gnuolcud/g1-all/main/g1-all.sgmodule
#!name=G1 ACQ v7.12 (Gemini Pro 7k + Ultra 75p)
#!desc=Pro 5TB → com.google.gemini 3T 99% off (~7k VND/T) | Ultra 20TB/30TB 75p | 5 presets | quản lý SKU
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/abd02e4/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/gnuolcud/g1-all/abd02e4/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
